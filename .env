# ============================================================================
# CONFIGURATION BACKEND - AUTO BI (MYSQL)
# ============================================================================

# Application
APP_NAME=AutoBI
APP_VERSION=1.0.0
DEBUG=True

# Base de données MySQL (MAMP)
# Format : mysql+pymysql://utilisateur:motdepasse@host:port/nom_base
DATABASE_URL=mysql+pymysql://root:root@localhost:3306/autobi

# Si MAMP utilise un port différent (par défaut 8889) :
# DATABASE_URL=mysql+pymysql://root:root@localhost:8889/autobi

# Sécurité JWT
SECRET_KEY=ma_cle
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS (Frontend URLs autorisées)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# Tokens par défaut à l'inscription
DEFAULT_TOKEN_BALANCE=5

# Serveur
HOST=0.0.0.0
PORT=8000


#OPEN AI
OPENAI_API_KEY=ma_cle